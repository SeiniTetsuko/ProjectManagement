def fetch_all_todos(owner_guid_list):
    """
    多个 owner 查询时，同一个父 Todo 可能重复返回。
    这里按 todo.id 去重。
    """
    all_todos = []
    seen_todo_ids = set()

    for owner_guid in owner_guid_list:
        todo_list = fetch_todo_list_by_owner(owner_guid)

        for todo in todo_list:
            todo_id = todo.get("id")
            dedupe_key = str(todo_id) if todo_id is not None else json.dumps(
                todo,
                ensure_ascii=False,
                sort_keys=True
            )

            if dedupe_key in seen_todo_ids:
                continue

            seen_todo_ids.add(dedupe_key)
            all_todos.append(todo)

    print(f"✅ 去重后 Todo 总数: {len(all_todos)}")

    return all_todos


