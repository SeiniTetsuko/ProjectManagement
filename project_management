def build_note_task_map(todo_list, mapping_rows, target_date):
    """
    输出结构：

    {
        note_guid: {
            project_guid,
            project_name,
            work_log_folder_guid,
            note_title,
            dept,
            owners: {
                owner_guid: {
                    owner_name,
                    owner_display_name,
                    owner_dept,
                    tasks: []
                }
            }
        }
    }
    """
    note_task_map = OrderedDict()
    daily_note_cache = {}

    total_subtodo = 0
    routed_subtodo = 0
    skipped_no_owner = 0
    skipped_no_mapping = 0
    skipped_no_daily_note = 0

    for todo in todo_list:
        todo_id = todo.get("id", "")
        todo_code = todo.get("code", "")
        parent_title = todo.get("title", "")
        parent_due_date = todo.get("dueDate", "")
        risk_level = todo.get("riskLevel", "")
        risk_text = RISK_MAP.get(risk_level, risk_level)

        sub_todos = todo.get("subTodos", []) or []

        if not sub_todos:
            print(f"⚠️ 跳过无 subTodos 的 Todo: {parent_title}")
            continue

        for sub in sub_todos:
            total_subtodo += 1

            sub_todo_id = sub.get("id", "")
            sub_title = sub.get("title", "")
            sub_due_date = sub.get("dueDate") or parent_due_date
            sub_status = sub.get("status", "")

            owner = sub.get("owner", {}) or {}
            owner_guid = owner.get("userGuid", "")
            owner_name = owner.get("name", "")
            owner_display_name = owner.get("displayName", owner_name)
            owner_full_dept = owner.get("fullDeptName", "")

            if not owner_guid:
                skipped_no_owner += 1
                print(
                    f"⚠️ 跳过无 owner.userGuid 的 subTodo: "
                    f"todo={todo_code}, subTodo={sub_todo_id}, title={sub_title}"
                )
                continue

            mapping = find_mapping_by_dept(owner_full_dept, mapping_rows)

            if not mapping:
                skipped_no_mapping += 1
                print(
                    f"⚠️ 未找到部门 mapping，跳过: "
                    f"owner={owner_display_name}, dept={owner_full_dept}, subTodo={sub_todo_id}"
                )
                continue

            project_guid = mapping["project_guid"]
            work_log_folder_guid = mapping["work_log_folder_guid"]
            project_name = mapping.get("project_name", "")
            mapping_dept = mapping["dept"]

            cache_key = f"{project_guid}|{work_log_folder_guid}|{target_date}"

            if cache_key not in daily_note_cache:
                daily_note = find_today_daily_note(
                    user_guid=USER_GUID,
                    project_guid=project_guid,
                    folder_guid=work_log_folder_guid,
                    target_date=target_date,
                    project_name=project_name
                )
                daily_note_cache[cache_key] = daily_note
            else:
                daily_note = daily_note_cache[cache_key]

            if not daily_note:
                skipped_no_daily_note += 1
                print(
                    f"⚠️ 未找到目标日报，跳过 subTodo: "
                    f"owner={owner_display_name}, dept={owner_full_dept}, subTodo={sub_todo_id}"
                )
                continue

            note_guid = daily_note["note_guid"]
            note_title = daily_note["note_title"]

            if note_guid not in note_task_map:
                note_task_map[note_guid] = {
                    "project_guid": project_guid,
                    "project_name": project_name,
                    "work_log_folder_guid": work_log_folder_guid,
                    "note_guid": note_guid,
                    "note_title": note_title,
                    "dept": mapping_dept,
                    "owners": OrderedDict()
                }

            owners = note_task_map[note_guid]["owners"]

            if owner_guid not in owners:
                owners[owner_guid] = {
                    "owner_guid": owner_guid,
                    "owner_name": owner_name,
                    "owner_display_name": owner_display_name,
                    "owner_dept": owner_full_dept,
                    "tasks": []
                }

            owners[owner_guid]["tasks"].append({
                "todo_id": todo_id,
                "todo_code": todo_code,
                "parent_title": parent_title,
                "subtodo_id": sub_todo_id,
                "subtodo_title": sub_title,
                "due_date": sub_due_date,
                "risk_level": risk_level,
                "risk_text": risk_text,
                "status": sub_status
            })

            routed_subtodo += 1

    print("\n================ 路由统计 ================\n")
    print(f"subTodo 总数: {total_subtodo}")
    print(f"成功路由: {routed_subtodo}")
    print(f"跳过：无 owner: {skipped_no_owner}")
    print(f"跳过：无 mapping: {skipped_no_mapping}")
    print(f"跳过：无当日日报: {skipped_no_daily_note}")
    print(f"目标日报数量: {len(note_task_map)}")
    print("\n==========================================\n")

    return note_task_map


